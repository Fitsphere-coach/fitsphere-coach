# Copy to apps/api/.env (never committed). Runbook, "Configuration names".
# Supabase -> Connect -> Session pooler, with the database password. Same project as the trainee app.
DATABASE_URL=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Gym onboarding (CF02, ADR-0004, ADR-0005, ADR-0008). Every value below is checked when the server
# starts; a missing or out-of-range one stops it and names the variable.
# Where the gym's details and the 6-digit approval code are emailed (FitSphere's team).
APPROVAL_INBOX=appbayaipower@gmail.com
# The Gmail account that sends it; must be the account SMTP_APP_PASSWORD belongs to.
SENDER_EMAIL=appbayaipower@gmail.com
SENDER_DISPLAY_NAME=FitSphere Coach
# Digits in the approval code (4 to 8)
APPROVAL_CODE_LENGTH=6
# Days a request stays valid (1 to 30)
GYM_REQUEST_VALID_DAYS=7
# Wrong codes allowed per request before it locks (1 to 10)
APPROVAL_WRONG_TRIES=5
# Requests one person may send per day, by India date (1 to 10)
GYM_REQUESTS_PER_DAY=3
# Secrets: leave empty here, fill in apps/api/.env only. Never commit them.
# A random text of at least 32 characters (for example: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))").
# Changing it makes open requests' codes stop working; those people send a new request.
APPROVAL_CODE_SECRET=
# A Google app password for SENDER_EMAIL (ADR-0005, "Owner set-up").
SMTP_APP_PASSWORD=
# Optional
PORT=3100
# HOST=0.0.0.0   # only while testing on a phone on the same Wi-Fi
# Local test database for npm run test:integration. Never Supabase.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitsphere_coach_test
